{
  "manifest_version": 3,
  "name": "Audio Normalizer & Equalizer",
  "version": "1.0.0",
  "description": "Normalizador de volumen en tiempo real, ecualizador gráfico de 10 bandas y VUMétro de sonido continuo para Chrome.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
